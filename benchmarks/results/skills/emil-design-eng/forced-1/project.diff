@@ -1,2 +1,24 @@
-.btn { background: #4f46e5; color: white; transition: all 300ms ease-in; }
-.btn:hover { transform: scale(0); }
+.btn {
+  background: #4f46e5;
+  color: white;
+  transition: background-color 140ms ease, box-shadow 140ms ease, transform 140ms cubic-bezier(0.23, 1, 0.32, 1);
+}
+
+@media (hover: hover) and (pointer: fine) {
+  .btn:hover {
+    background: #4338ca;
+    box-shadow: 0 2px 6px rgb(79 70 229 / 28%);
+  }
+}
+
+.btn:active {
+  transform: scale(0.97);
+  box-shadow: none;
+  transition-duration: 100ms;
+}
+
+@media (prefers-reduced-motion: reduce) {
+  .btn {
+    transition: background-color 140ms ease, box-shadow 140ms ease;
+  }
+}

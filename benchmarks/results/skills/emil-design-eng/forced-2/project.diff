diff --git a/src/button.css b/src/button.css
index dfb8d54..d8cdcaf 100644
--- a/src/button.css
+++ b/src/button.css
@@ -1,2 +1,31 @@
-.btn { background: #4f46e5; color: white; transition: all 300ms ease-in; }
-.btn:hover { transform: scale(0); }
+.btn {
+  background: #4f46e5;
+  color: white;
+  transition:
+    transform 140ms cubic-bezier(0.23, 1, 0.32, 1),
+    background-color 160ms ease,
+    box-shadow 160ms ease;
+  will-change: transform;
+}
+
+@media (hover: hover) and (pointer: fine) {
+  .btn:hover {
+    background-color: #4338ca;
+    box-shadow: 0 4px 10px rgb(79 70 229 / 22%);
+    transform: translateY(-1px);
+  }
+}
+
+.btn:active {
+  background-color: #3730a3;
+  box-shadow: 0 1px 3px rgb(55 48 163 / 28%);
+  transform: scale(0.97);
+  transition-duration: 90ms;
+}
+
+@media (prefers-reduced-motion: reduce) {
+  .btn {
+    transition: background-color 160ms ease, box-shadow 160ms ease;
+    will-change: auto;
+  }
+}

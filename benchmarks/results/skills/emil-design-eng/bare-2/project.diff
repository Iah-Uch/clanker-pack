diff --git a/src/button.css b/src/button.css
index dfb8d54..c8aa7c5 100644
--- a/src/button.css
+++ b/src/button.css
@@ -1,2 +1,31 @@
-.btn { background: #4f46e5; color: white; transition: all 300ms ease-in; }
-.btn:hover { transform: scale(0); }
+.btn {
+  background: #4f46e5;
+  color: #fff;
+  border: 1px solid transparent;
+  border-radius: 0.5rem;
+  cursor: pointer;
+  transition:
+    background-color 160ms ease,
+    box-shadow 160ms ease,
+    transform 120ms ease;
+}
+
+.btn:hover {
+  background: #4338ca;
+  box-shadow: 0 4px 10px rgb(79 70 229 / 24%);
+}
+
+.btn:active {
+  background: #3730a3;
+  box-shadow: 0 1px 3px rgb(79 70 229 / 20%);
+  transform: translateY(1px) scale(0.98);
+}
+
+.btn:focus-visible {
+  outline: 3px solid rgb(99 102 241 / 45%);
+  outline-offset: 2px;
+}
+
+@media (prefers-reduced-motion: reduce) {
+  .btn { transition: none; }
+}

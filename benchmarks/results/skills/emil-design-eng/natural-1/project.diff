diff --git a/src/button.css b/src/button.css
index dfb8d54..743878d 100644
--- a/src/button.css
+++ b/src/button.css
@@ -1,2 +1,32 @@
-.btn { background: #4f46e5; color: white; transition: all 300ms ease-in; }
-.btn:hover { transform: scale(0); }
+.btn {
+  background: #4f46e5;
+  color: #fff;
+  border: 1px solid transparent;
+  border-radius: 0.5rem;
+  cursor: pointer;
+  transform: translateY(0);
+  box-shadow: 0 1px 2px rgb(15 23 42 / 18%);
+  transition: background-color 160ms ease, box-shadow 160ms ease, transform 120ms ease;
+}
+
+.btn:hover {
+  background: #4338ca;
+  box-shadow: 0 4px 10px rgb(15 23 42 / 20%);
+  transform: translateY(-1px);
+}
+
+.btn:active {
+  background: #3730a3;
+  box-shadow: 0 1px 2px rgb(15 23 42 / 16%);
+  transform: translateY(1px);
+  transition-duration: 70ms;
+}
+
+.btn:focus-visible {
+  outline: 3px solid rgb(99 102 241 / 40%);
+  outline-offset: 3px;
+}
+
+@media (prefers-reduced-motion: reduce) {
+  .btn { transition: none; }
+}

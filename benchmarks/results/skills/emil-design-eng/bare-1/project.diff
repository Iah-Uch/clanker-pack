diff --git a/src/button.css b/src/button.css
index dfb8d54..ac3f4e0 100644
--- a/src/button.css
+++ b/src/button.css
@@ -1,2 +1,35 @@
-.btn { background: #4f46e5; color: white; transition: all 300ms ease-in; }
-.btn:hover { transform: scale(0); }
+.btn {
+  appearance: none;
+  border: 1px solid transparent;
+  border-radius: 0.625rem;
+  background: #4f46e5;
+  color: white;
+  cursor: pointer;
+  transition:
+    background-color 160ms ease,
+    box-shadow 160ms ease,
+    transform 120ms ease;
+}
+
+.btn:hover {
+  background: #4338ca;
+  box-shadow: 0 4px 12px rgb(79 70 229 / 28%);
+}
+
+.btn:active {
+  background: #3730a3;
+  box-shadow: 0 1px 3px rgb(79 70 229 / 24%);
+  transform: translateY(1px) scale(0.98);
+  transition-duration: 70ms;
+}
+
+.btn:focus-visible {
+  outline: 3px solid rgb(129 140 248 / 65%);
+  outline-offset: 3px;
+}
+
+@media (prefers-reduced-motion: reduce) {
+  .btn {
+    transition: none;
+  }
+}
